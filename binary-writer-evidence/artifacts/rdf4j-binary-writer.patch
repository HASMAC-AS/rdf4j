+			datatypes.add(datatype);
+		}
+		for (CoreDatatype datatype : CoreDatatype.RDF.values()) {
+			if (datatype != CoreDatatype.RDF.LANGSTRING && datatype != CoreDatatype.RDF.DIRLANGSTRING) {
+				datatypes.add(datatype);

+	private static byte[] serialize(List<String> names, BindingSet... rows) throws Exception {
+		ByteArrayOutputStream output = new ByteArrayOutputStream();
+		BinaryQueryResultWriter writer = new BinaryQueryResultWriter(output);
+		writer.startQueryResult(names);
+		for (BindingSet row : rows) {
+			writer.handleSolution(row);
+		}
+		writer.endQueryResult();
+		return output.toByteArray();
+	}
+
+	private static QueryResultCollector parse(byte[] bytes) throws Exception {
+		QueryResultCollector collector = new QueryResultCollector();
+		BinaryQueryResultParser parser = new BinaryQueryResultParser();
+		parser.setQueryResultHandler(collector);
+		parser.parseQueryResult(new ByteArrayInputStream(bytes));
+		return collector;
+	}
+
+	private static void assertRoundTrip(byte[] bytes, BindingSet... rows) throws Exception {
+		assertEquals(Arrays.asList(rows), parse(bytes).getBindingSets());
+	}
+
+	/**
+	 * Independently assembles the version-4 wire format without invoking the production writer.
+	 */
+	private static byte[] expectedStream(List<String> names, RecordWriter records) throws IOException {
+		ByteArrayOutputStream bytes = new ByteArrayOutputStream();
+		DataOutputStream out = new DataOutputStream(bytes);
+		out.write(new byte[] { 'B', 'R', 'T', 'R' });
+		out.writeInt(4);
+		out.writeInt(names.size());
+		for (String name : names) {
+			writeString(out, name);
+		}
+		records.write(out);
+		out.writeByte(127); // TABLE_END
+		return bytes.toByteArray();
+	}
+
+	private static void writeString(DataOutputStream out, String value) throws IOException {
+		byte[] bytes = value.getBytes(StandardCharsets.UTF_8);
+		out.writeInt(bytes.length);
+		out.write(bytes);
+	}
+
+	private static void writeNamespace(DataOutputStream out, int id, String namespace) throws IOException {
+		out.writeByte(2);
+		out.writeInt(id);
+		writeString(out, namespace);
+	}
+
+	private static void writeQName(DataOutputStream out, int id, String localName) throws IOException {
+		out.writeByte(3);
+		out.writeInt(id);
+		writeString(out, localName);
+	}
+
+	private static void writeBNode(DataOutputStream out, String id) throws IOException {
+		out.writeByte(5);
+		writeString(out, id);
+	}
+
+	private static void writeTypedLiteral(DataOutputStream out, String label, int namespaceId, String localName)
+			throws IOException {
+		out.writeByte(8);
+		writeString(out, label);
+		writeQName(out, namespaceId, localName);
+	}
+
+	private static void writeLanguageLiteral(DataOutputStream out, String label, String language) throws IOException {
+		out.writeByte(7);
+		writeString(out, label);
+		writeString(out, language);
+	}
+
+	@FunctionalInterface
+	private interface RecordWriter {
+		void write(DataOutputStream out) throws IOException;
+	}
+
+	private record StringCase(String description, String value) {
+	}
+}

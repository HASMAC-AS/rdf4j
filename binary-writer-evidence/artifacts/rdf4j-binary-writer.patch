+	@Test
+	void endQueryResultFlushesWithoutClosingTheSuppliedStream() throws Exception {
+		class ObservedOutput extends ByteArrayOutputStream {
+			boolean flushed;
+			boolean closed;
+
+			@Override
+			public void flush() {
+				flushed = true;
+			}
+
+			@Override
+			public void close() {
+				closed = true;
+			}
+		}
+		ObservedOutput output = new ObservedOutput();
+		BinaryQueryResultWriter writer = new BinaryQueryResultWriter(output);
+		writer.startQueryResult(ONE_COLUMN);
+		writer.handleSolution(new ListBindingSet(ONE_COLUMN, VF.createLiteral("value")));

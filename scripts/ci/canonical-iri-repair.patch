+class LmdbOwningTestStoreMetadataTest {
+
+	@TempDir
+	Path directory;
+
+	@Test
+	void freshOwnerMetadataRemainsUnpublishedUntilNativeInitialization() throws Exception {
+		StoreProperties properties = LmdbOwningTestStoreMetadata.open(directory.toFile(), config());
+		assertThat(properties.isLoaded()).as("new owner metadata must not imply an existing native generation")
+				.isFalse();
+		assertThat(directory.resolve(StoreProperties.FILE_NAME)).doesNotExist();
+		assertThat(directory.resolve("values/data.mdb")).doesNotExist();
+		assertThat(directory.resolve("triples/data.mdb")).doesNotExist();
+		assertThat(directory.resolve(LmdbStore.CORE_LITERAL_REFERENCE_MARKER_FILE)).isRegularFile();
+		assertCapabilities(LmdbStoreFormat.fromProperties(properties, config()));
+	}
+
+	@Test
+	void initializedPairReopensWithTheSamePersistedCapabilitiesAndIds() throws Exception {
+		IRI iri = Values.iri("urn:owner-fixture:kept");
+		long id = seedPair(iri);
+		byte[] originalMetadata = Files.readAllBytes(directory.resolve(StoreProperties.FILE_NAME));
+		StoreProperties properties = LmdbOwningTestStoreMetadata.open(directory.toFile(), config());
+		assertThat(properties.isLoaded()).isTrue();
+		ValueStore values = new ValueStore(directory.resolve("values").toFile(), properties, config());
+		try (TripleStore triples = new TripleStore(directory.resolve("triples").toFile(), properties, config(), values)) {
+			assertCapabilities(values.getFormat());
+			assertThat(values.getId(iri)).isEqualTo(id);
+			properties.save();
+			assertThat(Files.readAllBytes(directory.resolve(StoreProperties.FILE_NAME))).isEqualTo(originalMetadata);
+		} finally {
+			values.close();
+		}
+	}
+
+	@Test
+	void missingMetadataCannotRelabelAnExistingPairAsNew() throws Exception {
+		seedPair(Values.iri("urn:owner-fixture:kept"));
+		Files.delete(directory.resolve(StoreProperties.FILE_NAME));
+		var before = LmdbCompatibilityFixtures.snapshot(directory);
+		assertThatThrownBy(() -> LmdbOwningTestStoreMetadata.open(directory.toFile(), config()))
+				.isInstanceOf(SailException.class).hasMessageContaining("Missing store.properties");
+		assertThat(LmdbCompatibilityFixtures.snapshot(directory)).isEqualTo(before);
+	}
+
+	@Test
+	void publishedMetadataWithoutNativeDataStillFailsWithoutMutation() throws Exception {
+		StoreProperties properties = LmdbOwningTestStoreMetadata.open(directory.toFile(), config());
+		// Deliberately reproduce a damaged existing generation; never relax its production admission fence.
+		properties.save();
+		var before = LmdbCompatibilityFixtures.snapshot(directory);
+		assertThatThrownBy(() -> {
+			ValueStore unexpected = new ValueStore(directory.resolve("values").toFile(), properties, config());
+			unexpected.close();
+		}).isInstanceOf(IOException.class)
+				.hasMessage("Missing native ValueStore generation for existing LmdbStore format 7");
+		assertThat(LmdbCompatibilityFixtures.snapshot(directory)).isEqualTo(before);
+	}
+
+	@Test
+	void incompatibleReopenDoesNotRewriteThePersistedPolicy() throws Exception {
+		seedPair(Values.iri("urn:owner-fixture:kept"));
+		var before = LmdbCompatibilityFixtures.snapshot(directory);
+		assertThatThrownBy(() -> LmdbOwningTestStoreMetadata.open(directory.toFile(),
+				config().setInlineLiterals(true))).isInstanceOf(SailException.class)
+				.hasMessageContaining("original setting");
+		assertThat(LmdbCompatibilityFixtures.snapshot(directory)).isEqualTo(before);
+	}
+
+	private long seedPair(IRI iri) throws Exception {
+		File owner = directory.toFile();
+		LmdbStoreConfig config = config();
+		StoreProperties properties = LmdbOwningTestStoreMetadata.open(owner, config);
+		ValueStore values = new ValueStore(directory.resolve("values").toFile(), properties, config);
+		try (TripleStore triples = new TripleStore(directory.resolve("triples").toFile(), properties, config, values)) {
+			triples.initializeNamespaceSnapshot(Map.of());
+			properties.save();
+			assertThat(properties.isLoaded()).isTrue();
+			assertCapabilities(values.getFormat());
+			triples.startTransaction();
+			values.startTransaction(true);
+			long id = values.storeValue(iri);
+			long predicate = values.storeValue(Values.iri("urn:owner-fixture:predicate"));
+			triples.storeTriple(id, predicate, id, 0, true);
+			values.commit();
+			triples.commit();
+			return id;
+		} finally {
+			values.close();
+		}
+	}
+
+	private static void assertCapabilities(LmdbStoreFormat format) {
+		assertThat(format.getVersion()).isEqualTo(7);
+		assertThat(format.usesCanonicalIriEncoding()).isTrue();
+		assertThat(format.inlinesLiterals()).isFalse();
+		assertThat(format.usesOrderedNumericIds()).isTrue();
+		assertThat(format.usesCoreDatatypeLiteralReferences()).isTrue();
+		assertThat(format.usesCanonicalLanguageTags()).isTrue();
+		assertThat(format.usesZeroFractionDateTimeIds()).isTrue();
+	}
+
+	private static LmdbStoreConfig config() {
+		return new LmdbStoreConfig("spoc,posc,ospc").setInlineLiterals(false).setOrderedNumericIds(true)
+				.setValueDBSize(4L << 20).setTripleDBSize(4L << 20);
+	}
+}

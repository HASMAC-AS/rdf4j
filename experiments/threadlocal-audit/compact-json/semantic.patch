+	/** Writes only the already materialized compact schema, retaining Jackson validation and escaping. */
+	private static void writePackedRow(OutputStream output, List<Object> values) {
+		JsonGenerator generator = JSON_MAPPER.createGenerator(output);
+		try {
+			generator.writeStartArray(values, values.size());
+			for (int i = 0; i < values.size(); i++) {
+				try {
+					writePackedValue(generator, (Object[]) values.get(i));
+				} catch (JacksonException failure) {
+					throw failure.prependPath(values, i);
+				}
+			}
+			generator.writeEndArray();
+		} catch (Exception failure) {
+			// Match ObjectMapper.writeValue: do not auto-complete partial JSON on failure, and retain suppressed
+			// close failures. A plain try-with-resources would change malformed/failed oversized-row output.
+			ClassUtil.closeOnFailAndThrowAsJacksonE(generator, failure);
+			return;
+		}
+		generator.close();
+	}
+
+	private static void writePackedValue(JsonGenerator generator, Object[] value) {
+		if (value == null) {
+			generator.writeNull();
+			return;
+		}
+		generator.writeStartArray(value, value.length);
+		int kind = (Integer) value[0];
+		try {
+			generator.writeNumber(kind);
+		} catch (JacksonException failure) {
+			throw failure.prependPath(value[0], 0);
+		}
+		for (int i = 1; i < value.length; i++) {
+			Object field = value[i];
+			try {
+				if (kind == 3) {
+					writePackedValue(generator, (Object[]) field);
+				} else if (field == null) {
+					generator.writeNull();
+				} else if (field instanceof Boolean reference) {
+					generator.writeBoolean(reference);
+				} else {
+					generator.writeString((String) field);
+				}
+			} catch (JacksonException failure) {
+				// Match ObjectArraySerializer's reference chain without its normal-path dynamic dispatch.
+				throw failure.prependPath(field, i);
+			}
+		}
+		generator.writeEndArray();
+	}

+		output.failAfter(4 + 4 + 4 + 4 + 4096);
+
+		TupleQueryResultHandlerException failure = assertThrows(TupleQueryResultHandlerException.class,
+				() -> writer.startQueryResult(List.of("a".repeat(4095) + "\ud83d\ude80")));

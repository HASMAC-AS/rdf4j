+		String namespace = "http://example.org/";
+		BindingSet first = new ListBindingSet(names, VF.createIRI(namespace, "first"), null, VF.createLiteral("one"));
+		BindingSet second = new ListBindingSet(names, VF.createIRI(namespace, "first"), VF.createBNode("b1"),
+				VF.createLiteral("one"));
+		BindingSet afterEmpty = new ListBindingSet(names, VF.createIRI(namespace, "first"), VF.createBNode("b1"),
+				VF.createLiteral("one"));
+		BindingSet nulls = new ListBindingSet(names, null, null, VF.createLiteral("two"));
+		BindingSet afterNulls = new ListBindingSet(names, VF.createIRI(namespace, "first"), VF.createBNode("b1"),
+				VF.createLiteral("two"));
+		BindingSet[] rows = { first, second, EmptyBindingSet.getInstance(), afterEmpty, nulls, afterNulls };
+		byte[] actual = serialize(names, rows);
+		byte[] expected = expectedStream(names, out -> {
+			writeNamespace(out, 0, namespace);
+			writeQName(out, 0, "first");
+			out.writeByte(0); // NULL
+			writeNamespace(out, 1, XSD_NAMESPACE);
+			writeTypedLiteral(out, "one", 1, "string");
+			out.writeByte(1); // REPEAT
+			writeBNode(out, "b1");
+			out.writeByte(1);
+			out.writeByte(9); // EMPTY_ROW leaves the last nonempty tuple available for REPEAT.
+			out.write(new byte[] { 1, 1, 1 });
+			out.write(new byte[] { 0, 0 });
+			writeTypedLiteral(out, "two", 1, "string");
+			writeQName(out, 0, "first");
+			writeBNode(out, "b1");
+			out.writeByte(1);
+		});
+
+		assertArrayEquals(expected, actual);
+		assertRoundTrip(actual, rows);
+	}

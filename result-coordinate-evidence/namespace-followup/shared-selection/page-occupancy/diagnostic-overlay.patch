+			array(summary, "beforeFinalOccupiedSlots", beforeFinalOccupiedSlots);
+			array(summary, "beforeFinalLiveReferents", beforeFinalLiveReferents);
+			summary.append("}\n");
+			writer.write(summary.toString());
+		} catch (IOException failure) {
+			throw new UncheckedIOException("Cannot publish factor-page diagnostic " + output, failure);
+		}
+	}
+
+	private static void field(StringBuilder out, String name, long value) {
+		out.append(",\"").append(name).append("\":").append(value);
+	}
+
+	private static void array(StringBuilder out, String name, long[] values) {
+		out.append(",\"").append(name).append("\":[");
+		for (int i = 0; i < values.length; i++) {
+			if (i != 0) {
+				out.append(',');
+			}
+			out.append(values[i]);
+		}
+		out.append(']');
+	}
+
+	private static void quoted(StringBuilder out, String value) {
+		out.append('"');
+		for (int i = 0; i < value.length(); i++) {
+			char c = value.charAt(i);
+			if (c == '"' || c == '\\') {
+				out.append('\\').append(c);
+			} else if (c < 32) {
+				out.append("\\u");
+				for (int shift = 12; shift >= 0; shift -= 4) {
+					out.append(Character.forDigit((c >>> shift) & 15, 16));
+				}
+			} else {
+				out.append(c);
+			}
+		}
+		out.append('"');
+	}
+}

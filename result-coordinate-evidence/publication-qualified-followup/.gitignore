# Keep complete source, protocols, reports, commands, receipts, and raw observations.
# Compiled runtime inputs are packaged separately with their hash manifests.
**/__pycache__/
**/*.class
**/*.jar
**/classes/
**/test-classes/
**/production-classes/
**/compiled-all/
**/validation-overlay/
**/store/
**/target/
**/tmp/
**/*.hprof
delivery/*.tar.gz
delivery/*.zip
delivery/*.bundle

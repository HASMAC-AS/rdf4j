+				if (points[i].equals(point) && labels[i].equals(label) && strategies[i].equals(id)
+						&& modes[i].equals(record.mode())) {
+					counts[i]++;
+					return;
+				}
+			}
+			if (size == CAPACITY) {
+				omitted++;
+				return;
+			}
+			points[size] = point;
+			labels[size] = label;
+			strategies[size] = id;
+			modes[size] = record.mode();
+			counts[size++] = 1L;
+		}
+
+		public synchronized List<SelectedRoute> snapshot() {
+			List<SelectedRoute> result = new ArrayList<>(size);
+			for (int i = 0; i < size; i++) {
+				result.add(new SelectedRoute(points[i], labels[i], strategies[i], modes[i], counts[i]));
+			}
+			return List.copyOf(result);
+		}
+
+		public synchronized long omittedSelections() {
+			return omitted;
+		}
+
+		@Override
+		public void close() {
+			synchronized (OptionalFanoutRouteAccess.class) {
+				if (activeCapture == this) {
+					LmdbNativeDispatchLoop.observeSelections(null);
+					activeCapture = null;
+				}
+			}
+			synchronized (this) {
+				closed = true;
+			}
+		}
+	}
+}

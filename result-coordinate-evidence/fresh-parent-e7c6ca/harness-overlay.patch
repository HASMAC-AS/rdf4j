+				fixture.uniquePayloads == 0 ? (long) fixture.measurements * fixture.readings : fixture.uniquePayloads,
+				3L, 2L, 4L, 8L, 2L, 3L, 2L, 2L, fixture.statusCount }).limit(fixture.width).boxed().toList();
+		return fields("type", "metadata", "formatVersion", 1, "arm", options.arm, "source", options.source,

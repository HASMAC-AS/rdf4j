+	private static final class AllocationCounter {
+		private final ThreadMXBean bean;
+
+		private AllocationCounter() {
+			if (!(ManagementFactory.getThreadMXBean() instanceof ThreadMXBean supported)
+					|| !supported.isThreadAllocatedMemorySupported()) {
+				throw new IllegalStateException("This JVM cannot measure all-thread allocation");
+			}
+			bean = supported;
+			if (!bean.isThreadAllocatedMemoryEnabled()) {
+				bean.setThreadAllocatedMemoryEnabled(true);
+			}
+			if (total() < 0L) {
+				throw new IllegalStateException("All-thread allocation counter is unavailable");
+			}
+		}
+
+		long total() {
+			return bean.getTotalThreadAllocatedBytes();
+		}
+
+		long caller() {
+			return bean.getCurrentThreadAllocatedBytes();
+		}
+	}
+
+	private enum Consumption {
+		FULL,
+		EARLY,
+		RETAINED
+	}
+
+	private static final class Options {
+		private String arm = "unspecified";
+		private String source = "unspecified";
+		private int measurements = 100;
+		private int readings = 10;
+		private int width = 12;
+		private int statuses = 2;
+		private int uniquePayloads;
+		private int warmup = 3;
+		private int measurementsToRun = 5;
+		private long limit = 1_024L;
+		private long retain = 4_096L;
+		private Consumption consumption = Consumption.FULL;
+		private Path store;
+		private Path output;
+
+		static Options parse(String[] arguments) {
+			Options result = new Options();
+			for (String argument : arguments) {
+				int equals = argument.indexOf('=');
+				if (!argument.startsWith("--") || equals < 3) {
+					throw new IllegalArgumentException("Expected --name=value: " + argument);
+				}
+				String value = argument.substring(equals + 1);
+				switch (argument.substring(2, equals)) {
+				case "arm" -> result.arm = value;
+				case "source" -> result.source = value;
+				case "measurements" -> result.measurements = Integer.parseInt(value);
+				case "readings" -> result.readings = Integer.parseInt(value);
+				case "width" -> result.width = Integer.parseInt(value);
+				case "statuses" -> result.statuses = Integer.parseInt(value);
+				case "unique-payloads" -> result.uniquePayloads = Integer.parseInt(value);
+				case "warmup" -> result.warmup = Integer.parseInt(value);
+				case "iterations" -> result.measurementsToRun = Integer.parseInt(value);
+				case "limit" -> result.limit = Long.parseLong(value);
+				case "retain" -> result.retain = Long.parseLong(value);
+				case "consumption" -> result.consumption = Consumption.valueOf(value.toUpperCase(Locale.ROOT));
+				case "store" -> result.store = Path.of(value);
+				case "output" -> result.output = Path.of(value);
+				default -> throw new IllegalArgumentException("Unknown experiment option: " + argument);
+				}
+			}
+			if (result.warmup < 0 || result.measurementsToRun < 1 || result.limit < 1 || result.retain < 0) {
+				throw new IllegalArgumentException("Invalid warmup, iteration, limit, or retain count");
+			}
+			return result;
+		}
+	}
+
+	private static Map<String, Object> fields(Object... pairs) {
+		Map<String, Object> values = new LinkedHashMap<>();
+		for (int i = 0; i < pairs.length; i += 2) {
+			values.put((String) pairs[i], pairs[i + 1]);
+		}
+		return values;
+	}
+
+	private static void emit(PrintWriter output, Map<String, Object> record) throws IOException {
+		output.println(json(record));
+		output.flush();
+		if (output.checkError()) {
+			throw new IOException("Could not persist experiment JSONL");
+		}
+	}
+
+	private static String json(Object value) {
+		if (value == null) {
+			return "null";
+		}
+		if (value instanceof Number || value instanceof Boolean) {
+			return value.toString();
+		}
+		if (value instanceof Map<?, ?> map) {
+			return '{' + String.join(",", map.entrySet()
+					.stream()
+					.map(entry -> json(entry.getKey().toString()) + ':' + json(entry.getValue()))
+					.toList()) + '}';
+		}
+		if (value instanceof Iterable<?> iterable) {
+			List<String> parts = new ArrayList<>();
+			iterable.forEach(element -> parts.add(json(element)));
+			return '[' + String.join(",", parts) + ']';
+		}
+		String text = value.toString();
+		StringBuilder escaped = new StringBuilder(text.length() + 2).append('"');
+		for (int i = 0; i < text.length(); i++) {
+			char c = text.charAt(i);
+			switch (c) {
+			case '"' -> escaped.append("\\\"");
+			case '\\' -> escaped.append("\\\\");
+			case '\n' -> escaped.append("\\n");
+			case '\r' -> escaped.append("\\r");
+			case '\t' -> escaped.append("\\t");
+			default -> {
+				if (c < 0x20) {
+					escaped.append(String.format("\\u%04x", (int) c));
+				} else {
+					escaped.append(c);
+				}
+			}
+			}
+		}
+		return escaped.append('"').toString();
+	}
+}

+	private static boolean[] experimentalOmissions(String[] names, int[] aliases) {
+		boolean[] omitted = new boolean[names.length];
+		String configured = System.getProperty("rdf4j.lmdb.resultCoordinates.experiment.omitFactorTargets", "");
+		if (configured.isEmpty()) {
+			return omitted;
+		}
+		for (String entry : configured.split(",", -1)) {
+			String name = entry.trim();
+			if (name.isEmpty()) {
+				throw new IllegalArgumentException("Empty experimental factor target");
+			}
+			int target = -1;
+			for (int candidate = 0; candidate < names.length; candidate++) {
+				if (names[candidate].equals(name)) {
+					target = candidate;
+					break;
+				}
+			}
+			if (target < 0) {
+				throw new IllegalArgumentException("Unknown experimental factor target: " + name);
+			}
+			if (aliases[target] != target) {
+				throw new IllegalArgumentException("Experimental factor target must be canonical: " + name);
+			}
+			if (omitted[target]) {
+				throw new IllegalArgumentException("Duplicate experimental factor target: " + name);
+			}
+			omitted[target] = true;
+		}
+		return omitted;
 	}
 

+        and audit['harnessMain'] == FIXTURE['harnessMain'] and audit['readPhase'] == FIXTURE['rootReadPhase']
+    gc = gc_evidence(target / 'gc.log')
+    checks['gcLog'] = gc['lineCount'] > 0 and gc['g1Declared']
+    checks['noExplicitGcText'] = not gc['explicitSystemGcTextObserved']
+    analysis = {'format': 1, 'diagnosticOnly': True, 'valid': all(checks.values()), 'checks': checks,
+        'arm': entry['arm'], 'runId': entry['runId'], 'mask': entry['mask'],
+        'sourceIdentity': plan['sourceIdentity'], 'rawSamplesFile': str(raw_file), 'rawSamplesSha256': sha(raw_file),
+        'metadata': metadata, 'owners': owners, 'observations': observations, 'rootAudit': audit,
+        'rootAuditFile': str(audit_file), 'rootAuditSha256': sha(audit_file), 'gcLog': gc,
+        'performanceInference': False, 'acceptedTimingComparison': False,
+        'releaseCoverage': 'Page grants/releases are explicit. Ordinary/directory/memo are close-time claim snapshots; '
+            'harness zero ledger endpoints are checked separately. These charges are not physical memory.'}
+    write(target / 'analysis.json', analysis)
+    assert analysis['valid'], 'Preserved diagnostic validation failure: ' + str(target)
+    return analysis
+
+
+def run(args):
+    assert args.slot_granted, 'Java execution requires the coordinator exclusive slot'
+    folder, plan, _ = load_plan(args.name)
+    (folder / 'runs').mkdir(exist_ok=False)
+    completed, errors = [], []
+    try:
+        for entry in plan['commands']:
+            load_plan(args.name)
+            target = Path(entry['directory'])
+            target.mkdir()
+            (target / 'page-records').mkdir()
+            write(target / 'command.json', {**entry, 'startedEpochNs': time.time_ns(),
+                'protocolSha256': sha(folder / 'protocol.json'), 'runtimeSha256': plan['runtimeSha256']})
+            with (target / 'console.log').open('xb') as log:
+                try:
+                    process = subprocess.run(entry['argv'], cwd=ROOT, stdout=log, stderr=subprocess.STDOUT,
+                        timeout=plan['timeoutSeconds'])
+                except subprocess.TimeoutExpired:
+                    write(target / 'process-result.json', {'exitCode': None, 'timedOut': True, 'finishedEpochNs': time.time_ns()})
+                    raise
+            write(target / 'process-result.json', {'exitCode': process.returncode, 'timedOut': False,
+                'finishedEpochNs': time.time_ns()})
+            assert process.returncode == 0, 'Preserved diagnostic process failure'
+            analysis = validate_run(target, plan, entry)
+            completed.append({'runId': entry['runId'], 'arm': entry['arm'], 'directory': str(target),
+                'analysisFile': str(target / 'analysis.json'), 'analysisSha256': sha(target / 'analysis.json'),
+                'queryCount': len(analysis['observations']), 'observations': analysis['observations']})
+            print(json.dumps({'runId': entry['runId'], 'valid': True, 'queries': len(analysis['observations']),
+                'resolverCalls': [q['resolverCalls'] for q in analysis['observations']],
+                'ordinaryWeakBranches': sum(q['ordinaryPartition']['ordinaryWeakMiss'] for q in analysis['observations']),
+                'terminalFactorWeakBranches': sum(q['terminalFactorMissPartition']['factorWeakMiss'] for q in analysis['observations']),
+                'performanceInference': False}), flush=True)
+        load_plan(args.name)
+    except BaseException as failure:
+        errors.append({'class': type(failure).__name__, 'message': str(failure), 'traceback': traceback.format_exc()})
+        raise
+    finally:
+        count = sum(record['queryCount'] for record in completed)
+        write(folder / 'summary.json', {'format': 1, 'diagnosticOnly': True,
+            'complete': not errors and len(completed) == 4 and count == 52,
+            'completedAndValidatedJvms': len(completed), 'validatedQueryCount': count,
+            'protocolFile': str(folder / 'protocol.json'), 'protocolSha256': sha(folder / 'protocol.json'),
+            'runtime': plan['runtime'], 'runtimeSha256': plan['runtimeSha256'], 'sourceIdentity': plan['sourceIdentity'],
+            'runs': completed, 'errors': errors, 'performanceInference': False, 'acceptedTimingComparison': False,
+            'originalTimingEventCauseEstablished': False,
+            'interpretation': 'Instrumented branch observations only. No natural miss-rate, GC-performance, '
+                'allocation or latency inference; original timing protocol remains stopped.', 'finishedEpochNs': time.time_ns()})
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('action', choices=('prepare', 'run'))
+    parser.add_argument('--name', required=True)
+    parser.add_argument('--slot-granted', action='store_true')
+    args = parser.parse_args()
+    if args.action == 'prepare':
+        prepare(args)
+    else:
+        run(args)
+
+
+if __name__ == '__main__':
+    main()

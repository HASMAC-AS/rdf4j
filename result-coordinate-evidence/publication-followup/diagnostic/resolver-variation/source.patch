+def gc_evidence(path):
+    text = path.read_text()
+    lines = text.splitlines()
+    return {'file': str(path), 'sha256': sha(path), 'bytes': path.stat().st_size,
+        'lineCount': len(lines), 'g1Declared': 'Using G1' in text,
+        'gcEventIds': sorted({int(value) for value in re.findall(r'GC\((\d+)\)', text)}),
+        'referenceProcessingLineCount': sum(bool(re.search(r'\[gc,ref\s*\]', line)) for line in lines),
+        'explicitSystemGcTextObserved': 'System.gc()' in text,
+        'queryAlignmentAvailable': False, 'performanceInference': False}

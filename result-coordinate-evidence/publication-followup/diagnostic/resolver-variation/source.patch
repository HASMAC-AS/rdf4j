+def validate_run(target, plan, entry):
+    raw_file = target / 'samples.jsonl'
+    records = [json.loads(line) for line in raw_file.read_text().splitlines()]
+    metadata, queries = records[0], records[1:]
+    checks = {'queryCount': len(queries) == WARMUP + OBSERVED}
+    expected = {**FIXTURE['metadata'], 'source': plan['sourceIdentity'], 'arm': entry['harnessArm'],
+        'jvmArguments': entry['jvmArguments'], 'consumption': 'full', 'nativeEvaluation': True,
+        'directAdjacency': True, 'directAdjacencyMode': 'PREFER', 'valueOverlay': False, 'forceSync': False,
+        'globalLedgerLimitBytes': GLOBAL_LIMIT, 'perQueryLedgerLimitBytes': QUERY_LIMIT,
+        'indexes': 'spoc,ospc,psoc,posc', 'warmup': WARMUP, 'measurementsToRun': OBSERVED,
+        'projectedNames': NAMES, 'javaVersion': '25.0.5+8-LTS', 'javaVendor': 'Eclipse Adoptium',
+        'maxHeapBytes': GLOBAL_LIMIT}
+    checks.update({'metadata:' + key: metadata.get(key) == value for key, value in expected.items()})
+    properties = {arg[2:].split('=', 1)[0]: arg.split('=', 1)[1]
+        for arg in entry['jvmArguments'] if arg.startswith('-Drdf4j.')}
+    checks['metadata:systemProperties'] = metadata['systemProperties'] == properties
+    setup = metadata['adjacencySetup']
+    checks['adjacencySetup'] = setup['state'] == 'ACTIVE' and setup['currentRevisionReady']
+    paths = sorted((target / 'page-records').glob('owner-*.jsonl'), key=lambda p: int(p.stem.split('-')[1]))
+    owners = [legacy.owner_analysis(path) for path in paths]
+    checks['oneOwnerPerQuery'] = len(owners) == len(queries)
+    observations = []
+    for i, sample in enumerate(queries):
+        key = f'query{i}:'
+        counters, adjacency = sample['counters'], sample['adjacency']
+        checks[key + 'chronology'] = sample['iteration'] == i - WARMUP \
+            and sample['stage'] == ('warmup' if i < WARMUP else 'measurement')
+        checks[key + 'result'] = all(sample[field] for field in ('valid', 'complete', 'rowCountValid',
+            'checksumValid', 'exactBagValid', 'partialMembershipValid')) \
+            and sample['rows'] == FIXTURE['metadata']['expectedRows'] \
+            and sample['checksum'] == FIXTURE['metadata']['expectedChecksum']
+        checks[key + 'ledger'] = sample['ledgerBeforeBytes'] == sample['ledgerAfterBytes'] == 0 \
+            and sample['ledgerReleased'] and sample['ledgerPeakBytes'] <= QUERY_LIMIT
+        checks[key + 'normalAUTO'] = sample['autoRequested'] and sample['auto'] \
+            and bool(sample['successfulSelections']) and not any('forced' in r['mode'] for r in sample['successfulSelections'])
+        checks[key + 'nativeIR'] = counters['semanticNativeCompiles'] == counters['irOpened'] == 1 \
+            and counters['irRows'] == FIXTURE['metadata']['expectedRows']
+        checks[key + 'coordinateOwner'] = counters['coordinateAdmissions']['opened'] == 1
+        checks[key + 'compiledObservedQuery'] = i < WARMUP or counters['compiledBinds'] == 1 \
+            and counters['interpretedBinds'] == counters['aggregateCompiledBinds'] == counters['aggregateInterpretedBinds'] == 0
+        checks[key + 'adjacency'] = adjacency['stateBefore'] == adjacency['stateAfter'] == 'ACTIVE' \
+            and adjacency['currentRevisionBefore'] == adjacency['appliedRevisionBefore'] \
+            == adjacency['currentRevisionAfter'] == adjacency['appliedRevisionAfter'] == setup['currentDataRevision'] \
+            and adjacency['lookupHits'] > 0
+        if i >= len(owners):
+            continue
+        owner = owners[i]
+        targets = owner['targets']
+        checks[key + 'projectedNames'] = [t['name'] for t in targets] == NAMES
+        checks[key + 'noAliases'] = all(t['target'] == t['canonical'] == j for j, t in enumerate(targets))
+        checks[key + 'fullyBoundReads'] = sample['bindingReads'] == sample['rows'] * len(NAMES)
+        eligible = all(checks[key + part] for part in ('projectedNames', 'noAliases', 'fullyBoundReads'))
+        checks[key + 'findReconciliation'] = eligible and sum(t['find'] for t in targets) == sample['bindingReads']
+        checks[key + 'hitResolverReconciliation'] = eligible \
+            and sum(t['ordinaryHit'] + t['factorHit'] for t in targets) + counters['lazyValueCalls'] == sample['bindingReads']
+        checks[key + 'rememberResolverReconciliation'] = eligible \

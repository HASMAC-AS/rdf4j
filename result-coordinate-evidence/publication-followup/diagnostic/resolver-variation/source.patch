+def decomposition(owner, sample, reference, source_identity):
+    targets = []
+    for target, prior in zip(owner['targets'], reference['targets'], strict=True):
+        assert all(target[key] == prior[key] for key in IDENTITY_FIELDS)
+        delta = {key: value - prior[key] for key, value in target.items()
+            if key not in IDENTITY_FIELDS and isinstance(value, int) and value != prior[key]}
+        targets.append({'target': target['target'], 'name': target['name'], 'canonical': target['canonical'],
+            'ordinaryPartition': {key: target[key] for key in ORDINARY},
+            'terminalFactorMissPartition': {key: target[key] for key in FACTOR_MISSES},
+            'factorHits': target['factorHit'], 'rememberCalls': target['rememberCall'],
+            'pageAdmissionRefusals': target['pageRefused'], 'counterChangesFromSameArmReference': delta})
+    total = lambda key: sum(target[key] for target in owner['targets'])
+    return {'sourceIdentity': source_identity, 'generatedMaterializerSha256': SOURCE_SHA,
+        'rawOwnerFile': owner['path'], 'rawOwnerSha256': owner['sha256'],
+        'stage': sample['stage'], 'iteration': sample['iteration'],
+        'resolverCalls': sample['counters']['lazyValueCalls'],
+        'resolverDifferenceFromSameArmReference': sample['counters']['lazyValueCalls'] - reference['resolverCalls'],
+        'ordinaryPartition': {key: total(key) for key in ORDINARY},
+        'terminalFactorMissPartition': {key: total(key) for key in FACTOR_MISSES},
+        'factorHits': total('factorHit'), 'pageAdmissionRefusals': total('pageRefused'),
+        'coordinateAdmissionCounters': sample['counters']['coordinateAdmissions'],
+        'targets': targets,
+        'interpretation': 'Final factor misses are exclusive outcomes. Ordinary weak/witness branches may overlap '
+            'with final factor misses or be recovered by factor hits; do not add their counts as extra resolvers.',
+        'originalTimingEventCauseEstablished': False}
+

+        owner['sample'] = {field: sample[field] for field in ('stage', 'iteration', 'rows', 'bindingReads',
+            'checksum', 'ledgerBeforeBytes', 'ledgerPeakBytes', 'ledgerAfterBytes', 'counters', 'adjacency', 'successfulSelections')}
+        if eligible:
+            observations.append(decomposition(owner, sample, plan['references'][entry['arm']], plan['sourceIdentity']))
+    audit_file = target / 'root-host-audit.json'
+    audit = json.loads(audit_file.read_text())
+    checks['rootAudit'] = audit['harnessReturned'] and audit['harnessFailureClass'] is None \

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-testCompile</id>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.openjdk.jmh</groupId>
									<artifactId>jmh-generator-annprocess</artifactId>
									<version>${jmhVersion}</version>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					
					<forkCount>${forkCount}</forkCount>
					<reuseForks>true</reuseForks>
					<argLine>@{argLine} ${mockito.javaagent} -Xmx${rdf4j.lmdb.test.maxHeap} -Djava.awt.headless=true "-Djava.io.tmpdir=${rdf4j.test.tmpDirectory}/fork-${surefire.forkNumber}" "-Drdf4j.lmdb.test.forkTmpDirectory=${rdf4j.test.tmpDirectory}/fork-${surefire.forkNumber}" -Drdf4j.lmdb.test.forkNumber=${surefire.forkNumber}</argLine>
					<systemPropertyVariables>
						<rdf4j.test.outputDirectory>${project.build.directory}</rdf4j.test.outputDirectory>
						<rdf4j.test.tmpDirectory>${rdf4j.test.tmpDirectory}</rdf4j.test.tmpDirectory>
						<rdf4j.lmdb.test.surefire>true</rdf4j.lmdb.test.surefire>
						<rdf4j.lmdb.test.forkCount>${forkCount}</rdf4j.lmdb.test.forkCount>
						<org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.subjectBucketCount>4096</org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.subjectBucketCount>
						<org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.predicateBucketCount>64</org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.predicateBucketCount>
						<org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.objectBucketCount>4096</org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.objectBucketCount>
						<org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.contextBucketCount>16</org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.contextBucketCount>
						<org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.contextPairSketchesEnabled>false</org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.contextPairSketchesEnabled>
						<org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.nominalEntries>64</org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.nominalEntries>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-antrun-plugin</artifactId>
				<executions>
					<execution>
						<id>prepare-test-fork-directories</id>
						<phase>process-test-classes</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<skip>${maven.test.skip}</skip>
							<target>
								<java classname="org.eclipse.rdf4j.sail.lmdb.LmdbTestForkDirectories" failonerror="true">
									<classpath>
										<pathelement location="${project.build.testOutputDirectory}" />
									</classpath>
									<arg value="${rdf4j.test.tmpDirectory}" />
									<arg value="${forkCount}" />
									<arg value="${basedir}" />
								</java>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>properties-maven-plugin</artifactId>
				<executions>
					<execution>
						<id>capture-test-reactor-concurrency</id>
						<phase>generate-test-resources</phase>
						<goals>
							<goal>set-system-properties</goal>
						</goals>
						<configuration>
							<properties>
								<rdf4j.lmdb.test.reactorConcurrency>${session.request.degreeOfConcurrency}</rdf4j.lmdb.test.reactorConcurrency>
							</properties>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-failsafe-plugin</artifactId>
				<configuration>
					<systemPropertyVariables>
						<org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.subjectBucketCount>4096</org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.subjectBucketCount>
						<org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.predicateBucketCount>64</org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.predicateBucketCount>
						<org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.objectBucketCount>4096</org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.objectBucketCount>
						<org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.contextBucketCount>16</org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.contextBucketCount>
						<org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.contextPairSketchesEnabled>false</org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.contextPairSketchesEnabled>
						<org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.nominalEntries>64</org.eclipse.rdf4j.query.algebra.evaluation.sketch.SketchBasedJoinEstimator.nominalEntries>
					</systemPropertyVariables>
				</configuration>
			</plugin>
			<plugin>
				<artifactId>maven-assembly-plugin</artifactId>
			</plugin>
			<plugin>
				<artifactId>maven-clean-plugin</artifactId>
				<configuration>
					
					<excludeDefaultDirectories>true</excludeDefaultDirectories>
					<filesets>
						<fileset>
							<directory>${project.build.directory}</directory>
							<excludes>
								<exclude>lmdb-theme-query-benchmark/**</exclude>
							</excludes>
						</fileset>
					</filesets>
				</configuration>
			</plugin>
		</plugins>

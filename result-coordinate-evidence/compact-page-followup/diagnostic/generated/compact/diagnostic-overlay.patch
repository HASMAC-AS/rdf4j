+	private static void field(StringBuilder out, String name, long value) {
+		out.append(",\"").append(name).append("\":").append(value);
+	}
+
+	private static void text(StringBuilder out, String name, String value) {
+		out.append(",\"").append(name).append("\":");
+		quoted(out, value);
+	}
+
+	private static void quoted(StringBuilder out, String value) {
+		out.append('"');
+		for (int i = 0; i < value.length(); i++) {
+			char c = value.charAt(i);
+			if (c == '"' || c == '\\') {
+				out.append('\\').append(c);
+			} else if (c < 32) {
+				out.append(String.format("\\u%04x", (int) c));
+			} else {
+				out.append(c);
+			}
+		}
+		out.append('"');
+	}
+
+	private static void array(StringBuilder out, String name, long[] values) {
+		out.append(",\"").append(name).append("\":[");
+		for (int i = 0; i < values.length; i++) {
+			if (i != 0) {
+				out.append(',');
+			}
+			out.append(values[i]);
+		}
+		out.append(']');
+	}
+
+	private static void strings(StringBuilder out, String name, String[] values) {
+		out.append(",\"").append(name).append("\":[");
+		for (int i = 0; i < values.length; i++) {
+			if (i != 0) {
+				out.append(',');
+			}
+			quoted(out, values[i]);
+		}
+		out.append(']');
+	}
